{
  "experimental.theme_overrides": {
    "background": "${background}",
    "border": "${background}",
    "border.variant": "${surface_container}",
    "border.focused": "${primary}",
    "border.selected": "${primary}",
    "border.transparent": "${background}",
    "border.disabled": "${surface_container_low}",

    "elevated_surface.background": "${surface_container_high}",
    "surface.background": "${surface_container}",
    "panel.background": "${surface_container_low}",
    "panel.focused_border": "${primary}",
    "panel.indent_guide": "${surface_container}",
    "panel.indent_guide_active": "${surface_container_high}",
    "panel.indent_guide_hover": "${surface_container_high}",
    "pane.focused_border": "${primary}",
    "pane_group.border": "${surface_container}",
    "drop_target.background": "${primary_container}",

    "element.background": "${surface_container}",
    "element.hover": "${surface_container_high}",
    "element.active": "${primary_container}",
    "element.selected": "${primary_container}",
    "element.disabled": "${surface_variant}",
    "ghost_element.background": "${background}",
    "ghost_element.hover": "${surface_container}",
    "ghost_element.active": "${surface_container_high}",
    "ghost_element.selected": "${primary_container}",
    "ghost_element.disabled": "${surface_variant}",

    "text": "${onSurface}",
    "text.muted": "${onSurfaceVariant}",
    "text.placeholder": "${outline}",
    "text.disabled": "${outline}",
    "text.accent": "${primary}",
    "link_text.hover": "${secondary}",

    "icon": "${onSurface}",
    "icon.muted": "${onSurfaceVariant}",
    "icon.disabled": "${outline}",
    "icon.placeholder": "${outline}",
    "icon.accent": "${primary}",

    "status_bar.background": "${surface_container_low}",
    "title_bar.background": "${surface_container_low}",
    "title_bar.inactive_background": "${surface_container_lowest}",
    "toolbar.background": "${surface_container_low}",

    "tab_bar.background": "${surface_container_low}",
    "tab.active_background": "${surface_container_high}",
    "tab.inactive_background": "${surface_container_low}",

    "search.match_background": "${primary_container}",

    "scrollbar.thumb.background": "${surface_variant}",
    "scrollbar.thumb.hover_background": "${surface_container_high}",
    "scrollbar.thumb.border": "${surface_container}",
    "scrollbar.track.background": "${background}",
    "scrollbar.track.border": "${background}",

    "editor.background": "${background}",
    "editor.foreground": "${onSurface}",
    "editor.gutter.background": "${background}",
    "editor.subheader.background": "${surface_container_low}",
    "editor.active_line.background": "${surface_container_low}",
    "editor.highlighted_line.background": "${surface_container}",
    "editor.line_number": "${outline}",
    "editor.active_line_number": "${onSurface}",
    "editor.invisible": "${surface_container}",
    "editor.wrap_guide": "${surface_container}",
    "editor.active_wrap_guide": "${surface_container_high}",
    "editor.indent_guide": "${surface_container}",
    "editor.indent_guide_active": "${surface_container_high}",
    "editor.document_highlight.read_background": "${secondary_container}",
    "editor.document_highlight.write_background": "${tertiary_container}",
    "editor.document_highlight.bracket_background": "${surface_container_high}",

    "terminal.background": "${background}",
    "terminal.foreground": "${onSurface}",
    "terminal.bright_foreground": "${onSurface}",
    "terminal.dim_foreground": "${onSurfaceVariant}",
    "terminal.ansi.background": "${background}",
    "terminal.ansi.black": "${surface}",
    "terminal.ansi.bright_black": "${outline}",
    "terminal.ansi.dim_black": "${surface_container}",
    "terminal.ansi.red": "${error}",
    "terminal.ansi.bright_red": "${error}",
    "terminal.ansi.dim_red": "${error_container}",
    "terminal.ansi.green": "${secondary}",
    "terminal.ansi.bright_green": "${secondary}",
    "terminal.ansi.dim_green": "${secondary_container}",
    "terminal.ansi.yellow": "${tertiary}",
    "terminal.ansi.bright_yellow": "${tertiary}",
    "terminal.ansi.dim_yellow": "${tertiary_container}",
    "terminal.ansi.blue": "${primary}",
    "terminal.ansi.bright_blue": "${primary}",
    "terminal.ansi.dim_blue": "${primary_container}",
    "terminal.ansi.magenta": "${tertiary_container}",
    "terminal.ansi.bright_magenta": "${tertiary_container}",
    "terminal.ansi.dim_magenta": "${tertiary_container}",
    "terminal.ansi.cyan": "${secondary_container}",
    "terminal.ansi.bright_cyan": "${secondary_container}",
    "terminal.ansi.dim_cyan": "${secondary_container}",
    "terminal.ansi.white": "${onSurface}",
    "terminal.ansi.bright_white": "${onSurface}",
    "terminal.ansi.dim_white": "${onSurfaceVariant}",

    "error": "${error}",
    "error.background": "${error_container}",
    "error.border": "${error_container}",
    "warning": "${tertiary}",
    "warning.background": "${tertiary_container}",
    "warning.border": "${tertiary_container}",
    "info": "${secondary}",
    "info.background": "${secondary_container}",
    "info.border": "${secondary_container}",
    "success": "${secondary}",
    "success.background": "${secondary_container}",
    "success.border": "${secondary_container}",
    "hint": "${primary}",
    "hint.background": "${primary_container}",
    "hint.border": "${primary_container}",

    "created": "${secondary}",
    "created.background": "${secondary_container}",
    "created.border": "${secondary_container}",
    "modified": "${tertiary}",
    "modified.background": "${tertiary_container}",
    "modified.border": "${tertiary_container}",
    "deleted": "${error}",
    "deleted.background": "${error_container}",
    "deleted.border": "${error_container}",
    "renamed": "${secondary}",
    "renamed.background": "${secondary_container}",
    "renamed.border": "${secondary_container}",
    "conflict": "${error}",
    "conflict.background": "${error_container}",
    "conflict.border": "${error_container}",
    "ignored": "${outline}",
    "ignored.background": "${surface_variant}",
    "ignored.border": "${surface_variant}",
    "hidden": "${outline}",
    "hidden.background": "${surface_variant}",
    "hidden.border": "${surface_variant}",
    "unreachable": "${outline}",
    "unreachable.background": "${surface_variant}",
    "unreachable.border": "${surface_variant}",
    "predictive": "${onSurfaceVariant}",
    "predictive.background": "${surface_container}",
    "predictive.border": "${surface_container}",

    "syntax": {
      "comment": { "color": "${outline}" },
      "comment.doc": { "color": "${outline}" },
      "primary": { "color": "${onSurface}" },
      "string": { "color": "${secondary}" },
      "string.escape": { "color": "${tertiary}" },
      "string.regex": { "color": "${tertiary}" },
      "string.special": { "color": "${tertiary}" },
      "string.special.symbol": { "color": "${tertiary}" },
      "text.literal": { "color": "${secondary}" },
      "boolean": { "color": "${tertiary}" },
      "number": { "color": "${tertiary}" },
      "constant": { "color": "${tertiary}" },
      "keyword": { "color": "${primary}" },
      "operator": { "color": "${onSurfaceVariant}" },
      "function": { "color": "${tertiary}" },
      "constructor": { "color": "${secondary}" },
      "type": { "color": "${secondary}" },
      "enum": { "color": "${secondary}" },
      "variant": { "color": "${secondary}" },
      "namespace": { "color": "${secondary}" },
      "property": { "color": "${onSurfaceVariant}" },
      "variable": { "color": "${onSurface}" },
      "variable.special": { "color": "${primary}" },
      "label": { "color": "${primary}" },
      "tag": { "color": "${primary}" },
      "attribute": { "color": "${tertiary}" },
      "punctuation": { "color": "${onSurfaceVariant}" },
      "punctuation.bracket": { "color": "${onSurfaceVariant}" },
      "punctuation.delimiter": { "color": "${onSurfaceVariant}" },
      "punctuation.list_marker": { "color": "${primary}" },
      "punctuation.markup": { "color": "${onSurfaceVariant}" },
      "punctuation.special": { "color": "${tertiary}" },
      "selector": { "color": "${primary}" },
      "selector.pseudo": { "color": "${tertiary}" },
      "preproc": { "color": "${onSurfaceVariant}" },
      "embedded": { "color": "${onSurface}" },
      "emphasis": { "color": "${secondary}", "font_style": "italic" },
      "emphasis.strong": { "color": "${primary}", "font_weight": 700 },
      "title": { "color": "${primary}", "font_weight": 700 },
      "link_uri": { "color": "${secondary}" },
      "link_text": { "color": "${secondary}", "font_style": "italic" },
      "hint": { "color": "${primary}" },
      "predictive": { "color": "${onSurfaceVariant}" },
      "diff.plus": { "color": "${secondary}" },
      "diff.minus": { "color": "${error}" }
    }
  }
}
